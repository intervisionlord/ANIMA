{
  "$schema": "https://opencode.ai/config.json",
  "model": "YOUR_PROVIDER/YOUR_MODEL",
  "tools": {
    "browser*": false,
    "opencode*": false,
    "read": false,
    "write": false,
    "edit": false,
    "patch": false,
    "glob": false,
    "grep": false,
    "list": false,
    "bash": false,
    "shell": false,
    "webfetch": false,
    "websearch": false,
    "todowrite": false
  },
  "providers": {
    "YOUR_PROVIDER": {
      "name": "YOUR PROVIDER NAME",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.example.com/v1",
        "apiKey": "YOUR_API_KEY"
      },
      "options": {
        "streaming": true,
        "temperature": 0.3,
        "top_p": 0.9,
        "max_tokens": 4096,
        "frequency_penalty": 0.5
      },
      "models": {
        "YOUR_MODEL": {
          "modelID": "YOUR_MODEL_ID",
          "name": "YOUR MODEL NAME",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
